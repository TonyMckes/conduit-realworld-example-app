# Copy this file to `.env` and adjust to match your running Conduit instance.
# Defaults match TonyMckes/conduit-realworld-example-app running locally.

# Frontend (UI tests hit this)
BASE_URL=http://localhost:3000

# Backend API (API tests hit this)
API_URL=http://localhost:3001/api

# Optional: run browsers headless (true in CI, false locally if you want to watch)
# HEADLESS=true
